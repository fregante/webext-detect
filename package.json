{
	"name": "webext-detect",
	"version": "6.1.0",
	"description": "Detects where the current browser extension code is being run. Compatible with Firefox, Chrome and derivates.",
	"license": "MIT",
	"repository": "fregante/webext-detect",
	"funding": "https://github.com/sponsors/fregante",
	"author": "Federico Brigante <me@fregante.com> (https://fregante.com)",
	"type": "module",
	"exports": {
		"types": "./index.d.ts",
		"default": "./index.js"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc",
		"demo:build": "parcel build --no-cache",
		"demo:watch": "parcel watch --no-cache --no-hmr",
		"prepare": "tsc --sourceMap false",
		"test": "xo && tsc && node index.js",
		"watch": "tsc --watch"
	},
	"files": [
		"index.js",
		"index.d.ts"
	],
	"keywords": [
		"background page",
		"browser",
		"chrome",
		"content script",
		"detect",
		"extension",
		"context",
		"firefox",
		"safari",
		"options page",
		"web-ext",
		"webext",
		"where"
	],
	"devDependencies": {
		"@parcel/config-webextension": "^2.16.4",
		"@parcel/resolver-default": "^2.16.4",
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/chrome": "^0.3.5",
		"parcel": "^2.16.4",
		"typescript": "^6.0.3",
		"xo": "^5.0.1"
	},
	"xo": {
		"rules": {
			"@stylistic/function-paren-newline": "off"
		}
	},
	"@parcel/resolver-default": {
		"packageExports": true
	},
	"targets": {
		"main": false,
		"default": {
			"source": "demo/manifest.json",
			"distDir": "./distribution",
			"sourceMap": {
				"inline": true
			}
		}
	},
	"webExt": {
		"sourceDir": "distribution",
		"run": {
			"startUrl": [
				"https://example.com"
			]
		}
	}
}
